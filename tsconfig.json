{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "allowUmdGlobalAccess": true,
        "lib": ["ES2020", "DOM"],
        "types": ["d3"],
        "strict": true,
        "rootDir": "src",
        "outDir": "site/js",
        "sourceMap": true,
        "noEmitOnError": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
